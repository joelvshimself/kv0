PORT=3000
DATABASE_PATH=./data/kv0.db

# Apple Push Notification Service (APNs) - for iOS notifications
# Generate these from Apple Developer Portal
APNS_KEY_ID=your_key_id_here
APNS_TEAM_ID=your_team_id_here
APNS_KEY_PATH=./certs/AuthKey_XXXXXXXX.p8
APNS_BUNDLE_ID=com.kv0.app
APNS_PRODUCTION=false

# Firebase Cloud Messaging (FCM) - for Android notifications (if needed)
# Download service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./certs/firebase-service-account.json

# Notification Configuration
PRE_DIP_NOTIFICATION_MINUTES=30
WAKE_NOTIFICATION_OFFSET_MINUTES=-15
